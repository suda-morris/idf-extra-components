# The example is a host simulation: the panel lives in the process memory of the
# Linux target instead of an external display.
CONFIG_IDF_TARGET="linux"
CONFIG_SDL_BSP_NO_BOARD=y

# LVGL renders into an RGB888 framebuffer (B, G, R in memory, matching
# ESP_COLOR_FOURCC_BGR24)
CONFIG_LV_COLOR_DEPTH_24=y
CONFIG_LV_FONT_MONTSERRAT_14=y
