# ESP32-C5-DevKitC-1 USB-UART bridge is on UART0: U0TXD=GPIO11, U0RXD=GPIO12.
# Console stays on USB Serial/JTAG (ttyACM0); this port is the YMODEM peer
# (typically ttyUSB0) — same bench wiring as examples/xymodem_event.
CONFIG_EXAMPLE_UART_PORT_NUM=0
CONFIG_EXAMPLE_UART_TX_GPIO=11
CONFIG_EXAMPLE_UART_RX_GPIO=12
